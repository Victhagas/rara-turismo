---
import "../styles/site.css";
import RestOfPage from "../components/RestOfPage.astro";

const base = import.meta.env.BASE_URL;
const review = import.meta.env.PUBLIC_GITHUB_PREVIEW === "true";
const image = (name) => `${base}images/${name}.webp`;
const whatsapp = "https://wa.me/5521965094778?text=Ol%C3%A1%2C%20Rara!%20Vi%20o%20site%20de%20voc%C3%AAs%20e%20gostaria%20de%20planejar%20uma%20viagem.";
const contact = review ? { "aria-disabled": "true" } : { href: whatsapp };
const destinations = [
  { name: "Capri e Costa Amalfitana, Itália", photo: "capri", alt: "Faraglioni de Capri e barcos no mar turquesa" },
  { name: "Bangkok, Tailândia", photo: "bangkok", alt: "Templo Wat Arun à beira do rio ao entardecer" },
  { name: "Colmar, França", photo: "colmar", alt: "Casas coloridas e flores às margens do canal em Colmar" },
  { name: "Cabo da Roca, Portugal", photo: "cabo-da-roca", alt: "Farol no alto da falésia do Cabo da Roca" },
  { name: "Tromsø, Noruega", photo: "tromso", alt: "Aurora boreal sobre a cidade de Tromsø" },
];
const moreDestinations = [
  "Ilhas gregas", "Egito", "Nova York", "Curaçao", "Chile", "Holanda",
  "Países nórdicos", "Nordeste brasileiro", "Disney e Universal",
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Roteiros sob medida, indicação de hotéis e apoio durante a viagem com a Rara Turismo." />
    <title>{review ? "Prévia técnica | Rara Turismo" : "Rara Turismo | Viagens sob medida"}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}brand/monogram.svg`} />
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="#topo">
          <img src={`${base}brand/logo.svg`} alt="Rara Turismo" width="106" height="44" />
        </a>
        <a class="button button-primary topbar-contact" {...contact}>Falar no WhatsApp</a>
      </div>
    </header>

    <main id="topo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">Sua viagem desenhada sob medida, com alguém ao seu lado.</h1>
            <p class="hero-description">A gente monta o roteiro com você, indica onde ficar e atende a qualquer hora se surgir um imprevisto na viagem.</p>
            <div class="hero-actions">
              <a class="button button-primary" {...contact}>Planejar minha viagem <span aria-hidden="true">↗</span></a>
              <a class="button button-secondary" href="#destinos">Ver destinos <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <figure class="hero-photo">
            <img src={image("lago-de-como")} alt="Lago de Como, na Itália, com flores em primeiro plano e céu claro" width="1000" height="1778" fetchpriority="high" />
          </figure>
        </div>
      </section>

      <div class="shell interlude">
        <div class="interlude-mark" aria-hidden="true">
          <img src={`${base}brand/stamp-compass.webp`} alt="" width="173" height="224" loading="lazy" />
        </div>
        <p>Roteiros tão únicos quanto você.</p>
      </div>

      <section class="destinations" id="destinos" aria-labelledby="destinations-title">
        <div class="gallery-stage">
          <div class="gallery" id="destinations-list" role="group" aria-label="Carrossel de destinos" tabindex="0">
            <div class="gallery-intro">
              <p class="eyebrow">Destinos</p>
              <h2 id="destinations-title">Para onde a gente leva você</h2>
            </div>
            <ul class="gallery-items" aria-label="Destinos de viagem">
              {destinations.map((destination, index) => (
                <li class="destination">
                  <figure>
                    <img src={image(destination.photo)} alt={destination.alt} loading="lazy" decoding="async" />
                    <figcaption>
                      <span class="destination-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                      <span class="destination-name">{destination.name}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
              <li class="destination destination-more">
                <p class="eyebrow">E também</p>
                <ul>{moreDestinations.map((destination) => <li>{destination}</li>)}</ul>
                <p>E muitos outros destinos pelo mundo.</p>
              </li>
            </ul>
          </div>
          <div class="gallery-controls" aria-label="Controles da galeria">
            <button type="button" data-prev aria-label="Ver destino anterior" aria-controls="destinations-list" disabled>←</button>
            <button type="button" data-next aria-label="Ver próximo destino" aria-controls="destinations-list" disabled>→</button>
          </div>
        </div>
      </section>
      <RestOfPage {whatsapp} {base} {review} />
    </main>

    <RestOfPage {whatsapp} {base} {review} footer />
    <script>
      const section = document.querySelector<HTMLElement>("#destinos");
      const track = document.querySelector<HTMLElement>(".gallery");
      const previous = document.querySelector<HTMLButtonElement>("[data-prev]");
      const next = document.querySelector<HTMLButtonElement>("[data-next]");

      if (section && track && previous && next) {
        const stops = [...track.querySelectorAll<HTMLElement>(".gallery-intro, .destination")];
        const desktop = matchMedia("(min-width: 768px) and (prefers-reduced-motion: no-preference)");
        let travel = 0;

        const updateButtons = () => {
          previous.disabled = track.scrollLeft < 2;
          next.disabled = track.scrollLeft >= travel - 2;
        };

        const syncScroll = () => {
          if (desktop.matches) {
            track.scrollLeft = Math.min(travel, Math.max(0, -section.getBoundingClientRect().top));
          }
        };

        const measure = () => {
          travel = Math.max(0, track.scrollWidth - track.clientWidth);
          section.classList.toggle("scroll-linked", desktop.matches && travel > 0);
          section.style.setProperty("--gallery-travel", `${travel}px`);
          syncScroll();
          updateButtons();
        };

        const move = (direction: number) => {
          const starts = stops.map((card) => card.offsetLeft - stops[0].offsetLeft);
          const position = track.scrollLeft;
          const target = direction > 0
            ? Math.min(travel, starts.find((left) => left > position + 2) ?? travel)
            : starts.findLast((left) => left < position - 2) ?? 0;

          if (desktop.matches) {
            window.scrollTo({ top: window.scrollY + section.getBoundingClientRect().top + target, behavior: "smooth" });
          } else {
            track.scrollTo({ left: target });
          }
        };

        previous.addEventListener("click", () => move(-1));
        next.addEventListener("click", () => move(1));
        window.addEventListener("scroll", syncScroll, { passive: true });
        track.addEventListener("scroll", updateButtons, { passive: true });
        desktop.addEventListener("change", measure);
        new ResizeObserver(measure).observe(track);
        measure();
      }
    </script>
  </body>
</html>
