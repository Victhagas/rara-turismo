---
interface Props {
  whatsapp: string;
  base: string;
  footer?: boolean;
  review?: boolean;
}

const { whatsapp, base, footer = false, review = false } = Astro.props;
const contact = (href: string) => review ? { "aria-disabled": "true" } : { href };
const address = "R. Prudente de Morais, 1378 — Ipanema, Rio de Janeiro — RJ, 22041-040";
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(`Rara Turismo, ${address}`)}&output=embed`;
const mapLink = "https://maps.google.com/?cid=187773299751886460";
const services = [
  ["Roteiros sob medida", "O roteiro parte do que você quer fazer. Organizamos viagens pelo Brasil e por destinos como Itália, Grécia, Tailândia e países nórdicos."],
  ["Indicação de hotéis", "Você recebe sugestões de hospedagem para cada destino, com detalhes de cada opção para decidir onde ficar."],
  ["Guias na Disney e na Universal", "Você pode contar com um guia no parque ou receber orientação pelo WhatsApp, com acompanhamento da sua localização em tempo real."],
  ["Cruzeiros Disney", "A gente ajuda a comparar os navios, dos clássicos aos mais temáticos, e a escolher um roteiro, incluindo opções pelo Caribe."],
  ["Ajuda 24 horas durante a viagem", "Se surgir uma emergência na viagem, fale com a gente para encontrar uma saída."],
  ["Viagens em grupo e pelo Nordeste", "Organizamos viagens em grupo e roteiros pelo Nordeste. Na temporada de kitesurf, dá para ir a Cumbuco ou Fortim, no Ceará."],
];
const questions = [
  ["Como funcionam os guias na Disney e na Universal?", "Com o guia virtual, você conversa pelo WhatsApp. Ele acompanha sua localização em tempo real e agenda as atrações. O guia presencial acompanha você no parque e cuida dos horários e dos deslocamentos. A gente ajuda a escolher conforme o grupo, o orçamento e o quanto você quer fazer por conta própria."],
  ["O roteiro é pronto ou vocês montam do zero?", "A gente monta o roteiro para você, levando em conta quem vai viajar, o que vocês querem fazer e o ritmo que preferem."],
  ["Onde ficam os vouchers e o roteiro?", "Você recebe um site só da sua viagem. Lá estão os vouchers para baixar em PDF, o roteiro de cada dia e dicas do destino."],
  ["Com quem falo se tiver um imprevisto na viagem?", "Com a nossa equipe. O atendimento para emergências durante a viagem funciona 24 horas."],
  ["Posso passar na agência? Em que horário?", "Sim. Ficamos na R. Prudente de Morais, 1378, em Ipanema, Rio de Janeiro. Atendemos de segunda a sábado, das 9h às 18h, e aos domingos, das 9h às 16h."],
];
---

{footer ? (
  <footer class="contact">
    <div class="section-shell contact-inner">
      <h2>Vamos conversar sobre sua viagem?</h2>
      <p class="contact-copy">Mande uma mensagem com o que você já sabe da viagem. Pode ser só uma ideia de destino.</p>
      <a class="button button-primary contact-button" {...contact(whatsapp)}>Chamar no WhatsApp</a>
      <div class="contact-meta">
        <div class="footer-address">
          <a class="footer-brand" href="#topo">
            <img src={`${base}brand/logo-light.svg`} alt="Rara Turismo" width="106" height="44" loading="lazy" />
          </a>
          <p>{address}</p>
        </div>
        <a {...contact("https://www.instagram.com/raraturismo/")}>Instagram</a>
      </div>
    </div>
  </footer>
) : (
  <>
    <section class="section-shell services" aria-labelledby="services-title">
      <p class="eyebrow">Serviços</p>
      <h2 id="services-title">Como a gente pode ajudar na sua viagem</h2>
      <ol class="service-list">
        {services.map(([name, description], index) => (
          <li>
            <span class="service-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <p>{description}</p>
            <span class="service-arrow" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="planning" aria-labelledby="planning-title">
      <div class="section-shell planning-inner">
        <figure class="planning-image">
          <img src={`${base}images/tulipas.webp`} alt="Mulher de casaco caminhando em um campo de tulipas" width="900" height="1597" loading="lazy" decoding="async" />
        </figure>
        <div class="planning-copy">
          <p class="eyebrow">Planejamento</p>
          <h2 id="planning-title">Como a gente monta seu roteiro</h2>
          <p>Primeiro, a gente conversa sobre quem vai viajar, que tipo de hotel vocês preferem e quanto tempo livre querem ter.</p>
          <p>Depois, organizamos o roteiro dia a dia. Se surgir um imprevisto durante a viagem, nossa equipe atende a qualquer hora.</p>
          <p>Antes de viajar, você recebe um site só da sua viagem, com os vouchers em PDF, o roteiro de cada dia e dicas do destino.</p>
        </div>
      </div>
    </section>

    <section class="section-shell faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Perguntas frequentes</h2>
      <div class="faq-list">
        {questions.map(([question, answer]) => (
          <details>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="section-shell location" aria-labelledby="location-title">
      <div>
        <div class="location-heading">
          <h2 id="location-title">Onde estamos</h2>
          <img src={`${base}brand/stamp-map.webp`} alt="" width="168" height="224" loading="lazy" />
        </div>
        <address>{address}</address>
        <a class="location-phone" {...contact("tel:+5521965094778")}>(21) 96509-4778</a>
        <dl>
          <div><dt>Segunda a sábado</dt><dd>9h às 18h</dd></div>
          <div><dt>Domingo</dt><dd>9h às 16h</dd></div>
        </dl>
        <a class="location-link" href={mapLink}>Abrir no Google Maps <span aria-hidden="true">→</span></a>
      </div>
      <iframe src={mapEmbed} title="Mapa da Rara Turismo em Ipanema" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
  </>
)}

<style>
  .section-shell {
    width: min(100%, 72rem);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  h2 {
    font-size: clamp(2.25rem, 5vw, 3rem);
    line-height: 1.04;
    text-wrap: balance;
  }

  .services, .location {
    padding-block: clamp(6.5rem, 10vw, 9rem);
  }

  .services h2 { max-width: 42rem; }

  .service-list, .faq-list {
    margin: 3.5rem 0 0;
    padding: 0;
    border-block: 1px solid var(--rule);
  }

  .service-list li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1.4fr) auto;
    align-items: baseline;
    gap: 2rem;
    padding-block: 2rem;
  }

  .service-list li + li, details + details {
    border-top: 1px solid var(--rule);
  }

  .service-number {
    color: var(--accent);
    font: 500 1.3rem/1 var(--display);
    font-variant-numeric: tabular-nums;
  }

  .service-list h3 {
    margin: 0;
    font: 500 clamp(1.5rem, 3vw, 1.875rem)/1.07 var(--display);
  }

  .service-list li p, details p, .planning-copy > p:not(.eyebrow) {
    color: color-mix(in srgb, var(--ink) 78%, var(--paper));
  }

  .service-arrow { color: var(--accent); }

  .planning { background: var(--sand); }

  .planning-inner, .location {
    display: grid;
    grid-template-columns: 5fr 6fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .planning-inner { padding-block: clamp(6.5rem, 12vw, 10rem); }

  .planning-image {
    overflow: hidden;
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 9 / 14;
    max-height: 85svh;
  }

  .planning-image img { height: 100%; object-fit: cover; }

  .planning-copy > p:not(.eyebrow) {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .faq { max-width: 48rem; padding-block: 6rem; }
  .faq-list { margin-top: 2.5rem; }

  details { padding-block: 1.5rem; }

  details summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    cursor: pointer;
    font-size: 1.125rem;
  }

  details summary::-webkit-details-marker { display: none; }
  details summary span { flex-shrink: 0; font-size: 1.35rem; line-height: 1; transition: transform 180ms ease; }
  details[open] summary span { transform: rotate(45deg); }
  details p { margin-top: 1rem; }

  .location {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .location-heading { display: flex; align-items: center; gap: 1.1rem; }
  .location-heading h2 { margin-top: 0; }
  .location-heading img { flex-shrink: 0; width: clamp(3rem, 6vw, 3.875rem); height: auto; transform: rotate(7deg); }

  .location address {
    margin-top: 2rem;
    font-size: 1.125rem;
    font-style: normal;
  }

  .location-phone { display: inline-block; margin-top: 0.5rem; font-size: 1.125rem; }

  .location dl { margin: 2.5rem 0 0; }

  .location dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-block: 0.65rem;
  }

  .location dd { margin: 0; font-variant-numeric: tabular-nums; }
  .location-link { display: inline-block; margin-top: 2rem; color: var(--accent); }

  .location iframe {
    width: 100%;
    aspect-ratio: 1;
    border: 0;
    border-radius: var(--radius);
    background: var(--sand);
    filter: grayscale(1);
  }

  .contact { color: var(--panel-light); background: var(--panel-dark); }
  .contact-inner { padding-block: 7rem; }
  .contact h2 { max-width: 48rem; font-size: clamp(3rem, 7vw, 4.5rem); }
  .contact-copy { margin-top: 1.5rem; font-size: 1.125rem; opacity: 0.82; }
  .contact-button { margin-top: 2.5rem; border-radius: 999px; padding: 1rem 1.75rem; color: #423d3d; background: var(--gold); }
  .contact-button:not([aria-disabled="true"]):hover { background: color-mix(in srgb, var(--gold) 85%, white); }

  .contact-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 6rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--panel-light) 24%, transparent);
    font-size: 0.875rem;
  }
  .footer-address { display: flex; align-items: center; gap: 1rem; }
  .footer-brand { flex: 0 0 5.5rem; }
  .footer-brand img { height: auto; }
  .footer-address p { opacity: 0.82; }

  .location a:hover, .contact-meta a:hover { text-decoration: underline; text-underline-offset: 0.24em; }

  @media (max-width: 767px) {
    .service-list li { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .service-arrow { display: none; }
    .planning-inner, .location { grid-template-columns: minmax(0, 1fr); }
    .contact-meta { flex-direction: column; align-items: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    details summary span { transition: none; }
  }
</style>
