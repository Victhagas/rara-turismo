---
import "../styles/site.css";
import "../styles/night.css";
import RestOfPage from "./RestOfPage.astro";

interface Props {
  edition: "day" | "night";
}

const base = import.meta.env.BASE_URL;
const review = import.meta.env.PUBLIC_GITHUB_PREVIEW === "true";
const night = Astro.props.edition === "night";
const image = (name) => `${base}images/${name}.webp`;
const cover = night
  ? { photo: "tromso", alt: "Aurora boreal verde sobre a ponte e as luzes de Tromsø", place: "Tromsø, Noruega", width: 864, height: 1536 }
  : { photo: "lago-de-como", alt: "Barco no Lago de Como, com flores em primeiro plano e a bandeira italiana na margem", place: "Lago de Como, Itália", width: 1000, height: 1778 };
const whatsapp = "https://wa.me/5521965094778?text=Ol%C3%A1%2C%20Rara!%20Vi%20o%20site%20de%20voc%C3%AAs%20e%20gostaria%20de%20planejar%20uma%20viagem.";
const contact = review ? { "aria-disabled": "true" } : { href: whatsapp };
const destinations = [
  { name: "Capri e Costa Amalfitana, Itália", photo: "capri", alt: "Faraglioni de Capri e barcos no mar turquesa" },
  { name: "Bangkok, Tailândia", photo: "bangkok", alt: "Templo Wat Arun à beira do rio ao entardecer" },
  { name: "Colmar, França", photo: "colmar", alt: "Casas coloridas e flores às margens do canal em Colmar" },
  { name: "Cabo da Roca, Portugal", photo: "cabo-da-roca", alt: "Farol no alto da falésia do Cabo da Roca" },
  { name: "Tromsø, Noruega", photo: "tromso", alt: "Aurora boreal sobre a cidade de Tromsø" },
];
const moreDestinations = [
  "Ilhas gregas", "Egito", "Nova York", "Curaçao", "Chile", "Holanda",
  "Países nórdicos", "Nordeste brasileiro", "Disney e Universal",
];
---
<!doctype html>
<html lang="pt-BR" data-theme={night ? "night" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Roteiros sob medida, indicação de hotéis e apoio durante a viagem com a Rara Turismo." />
    <title>{review ? (night ? "Prévia noturna | Rara Turismo" : "Prévia técnica | Rara Turismo") : "Rara Turismo | Viagens sob medida"}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}brand/monogram.svg`} />
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="#topo">
          <img src={`${base}brand/${night ? "logo-light" : "logo"}.svg`} alt="Rara Turismo" width="106" height="44" />
        </a>
        <div class="topbar-actions">
          {review && (
            <a class="edition-link" href={night ? base : `${base}noite/`} aria-label={night ? "Ver a capa de dia" : "Ver a capa à noite"}>
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {night ? (
                  <><circle cx="10" cy="10" r="3.4" /><path d="M10 2v2m0 12v2M2 10h2m12 0h2M4.4 4.4l1.4 1.4m8.4 8.4 1.4 1.4m0-11.2-1.4 1.4m-8.4 8.4-1.4 1.4" /></>
                ) : (
                  <><path d="M15.7 12.2A6.5 6.5 0 0 1 7.8 4.3a6.6 6.6 0 1 0 7.9 7.9Z" /><path d="M13 2.6v4m-2-2h4" /></>
                )}
              </svg>
              {night ? "Dia" : "Noite"}
            </a>
          )}
          <a class="button button-primary topbar-contact" {...contact}>Falar no WhatsApp</a>
        </div>
      </div>
    </header>

    <main id="topo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="shell hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">Sua viagem desenhada sob medida, com alguém ao seu lado.</h1>
            <p class="hero-description">A gente monta o roteiro com você, indica onde ficar e atende a qualquer hora se surgir um imprevisto na viagem.</p>
            <div class="hero-actions">
              <a class="button button-primary" {...contact}>Planejar minha viagem <span aria-hidden="true">↗</span></a>
              <a class="button button-secondary" href="#destinos">Ver destinos <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <figure class="hero-photo" data-day-motion={night ? undefined : ""} data-night-motion={night ? "" : undefined}>
            <img src={image(cover.photo)} alt={cover.alt} width={cover.width} height={cover.height} fetchpriority="high" />
            <canvas class="hero-motion" aria-hidden="true"></canvas>
            <figcaption class="scene-caption">
              <span>{cover.place}</span>
              <button class="motion-toggle" type="button" aria-label="Pausar animação" aria-pressed="false" title="Pausar animação" hidden>
                <svg class="motion-pause" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
                  <path d="M7.4 5.5v9m5.2-9v9" />
                </svg>
                <svg class="motion-play" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M7 4.8 15 10l-8 5.2z" />
                </svg>
              </button>
            </figcaption>
          </figure>
        </div>
      </section>

      <div class="shell interlude">
        {night && (
          <div class="aurora-echo" aria-hidden="true">
            <svg viewBox="0 0 1400 390" fill="none" preserveAspectRatio="xMidYMid slice">
              <defs>
                <linearGradient id="aurora-light" x1="25" y1="310" x2="1360" y2="60" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#146b62" stop-opacity="0" />
                  <stop offset=".27" stop-color="#43ba92" stop-opacity=".38" />
                  <stop offset=".59" stop-color="#b4e69b" stop-opacity=".53" />
                  <stop offset=".82" stop-color="#2bb39d" stop-opacity=".36" />
                  <stop offset="1" stop-color="#167b82" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g stroke="url(#aurora-light)" stroke-linecap="round">
                <path class="aurora-halo" d="M-40 340C180 380 360 78 610 159S992 256 1430 7" stroke-width="105" />
                <path class="aurora-ribbon" d="M-50 338C172 359 382 115 601 162S976 267 1420 22" stroke-width="31" />
                <path class="aurora-ribbon" d="M10 346C283 387 395 160 649 199S1005 256 1416 66" stroke-width="14" opacity=".68" />
              </g>
            </svg>
          </div>
        )}
        <div class="interlude-mark" aria-hidden="true">
          <img src={`${base}brand/stamp-compass.webp`} alt="" width="173" height="224" loading="lazy" />
        </div>
        <p>Ainda escolhendo o destino?</p>
      </div>

      <section class="destinations" id="destinos" aria-labelledby="destinations-title">
        <div class="gallery-stage">
          <div class="gallery" id="destinations-list" role="group" aria-label="Carrossel de destinos" tabindex="0">
            <div class="gallery-intro">
              <p class="eyebrow">Destinos</p>
              <h2 id="destinations-title">Algumas ideias para a sua viagem</h2>
            </div>
            <ul class="gallery-items" aria-label="Destinos de viagem">
              {destinations.map((destination, index) => (
                <li class="destination">
                  <figure>
                    <img src={image(destination.photo)} alt={destination.alt} loading="lazy" decoding="async" />
                    <figcaption>
                      <span class="destination-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                      <span class="destination-name">{destination.name}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
              <li class="destination destination-more">
                <p class="eyebrow">Mais lugares</p>
                <ul>{moreDestinations.map((destination) => <li>{destination}</li>)}</ul>
                <p>Tem outro destino em mente? Conta pra gente.</p>
              </li>
            </ul>
          </div>
          <div class="gallery-controls" aria-label="Controles da galeria">
            <button type="button" data-prev aria-label="Ver destino anterior" aria-controls="destinations-list" disabled>←</button>
            <button type="button" data-next aria-label="Ver próximo destino" aria-controls="destinations-list" disabled>→</button>
          </div>
        </div>
      </section>
      <RestOfPage {whatsapp} {base} {review} />
    </main>

    <RestOfPage {whatsapp} {base} {review} footer />
    <script>
      const figure = document.querySelector<HTMLElement>(".hero-photo");
      const motionToggle = figure?.querySelector<HTMLButtonElement>(".motion-toggle");

      if (figure && motionToggle) {
        const nightScene = figure.hasAttribute("data-night-motion");
        const echo = document.querySelector<HTMLElement>(".aurora-echo");
        const motionPreference = matchMedia("(prefers-reduced-motion: no-preference)");
        const updateToggle = () => {
          motionToggle.hidden = !motionPreference.matches || !(figure.hasAttribute("data-motion-ready") || echo);
        };

        let echoFrame = 0;
        const syncEcho = () => {
          if (!echo || echoFrame || !motionPreference.matches || figure.hasAttribute("data-motion-paused")) return;
          echoFrame = requestAnimationFrame(() => {
            echoFrame = 0;
            const { top, bottom, height } = echo.getBoundingClientRect();
            if (top > innerHeight || bottom < 0) return;
            const progress = (innerHeight - top) / (innerHeight + height);
            echo.style.setProperty("--echo-x", `${-18 + 26 * progress}%`);
            echo.style.setProperty("--echo-y", `${10 - 24 * progress}%`);
            echo.style.setProperty("--echo-angle", `${-8 + 13 * progress}deg`);
          });
        };

        motionToggle.addEventListener("click", () => {
          const paused = figure.toggleAttribute("data-motion-paused");
          document.documentElement.toggleAttribute("data-motion-paused", paused);
          motionToggle.setAttribute("aria-pressed", String(paused));
          motionToggle.title = paused ? "Retomar animação" : "Pausar animação";
          syncEcho();
        });
        new MutationObserver(updateToggle).observe(figure, { attributes: true, attributeFilter: ["data-motion-ready"] });
        motionPreference.addEventListener("change", updateToggle);
        updateToggle();
        if (echo) {
          window.addEventListener("scroll", syncEcho, { passive: true });
          window.addEventListener("resize", syncEcho);
          motionPreference.addEventListener("change", syncEcho);
          syncEcho();
        }

        if (nightScene) {
          import("../scripts/night-motion").then(({ initNightMotion }) => initNightMotion(figure));
        } else {
          import("../scripts/day-motion").then(({ initDayMotion }) => initDayMotion(figure));
        }
      }

      const section = document.querySelector<HTMLElement>("#destinos");
      const track = document.querySelector<HTMLElement>(".gallery");
      const previous = document.querySelector<HTMLButtonElement>("[data-prev]");
      const next = document.querySelector<HTMLButtonElement>("[data-next]");

      if (section && track && previous && next) {
        const stops = [...track.querySelectorAll<HTMLElement>(".gallery-intro, .destination")];
        const desktop = matchMedia("(min-width: 768px) and (prefers-reduced-motion: no-preference)");
        let travel = 0;

        const updateButtons = () => {
          previous.disabled = track.scrollLeft < 2;
          next.disabled = track.scrollLeft >= travel - 2;
        };

        const syncScroll = () => {
          if (desktop.matches) {
            track.scrollLeft = Math.min(travel, Math.max(0, -section.getBoundingClientRect().top));
          }
        };

        const measure = () => {
          travel = Math.max(0, track.scrollWidth - track.clientWidth);
          section.classList.toggle("scroll-linked", desktop.matches && travel > 0);
          section.style.setProperty("--gallery-travel", `${travel}px`);
          syncScroll();
          updateButtons();
        };

        const move = (direction: number) => {
          const starts = stops.map((card) => card.offsetLeft - stops[0].offsetLeft);
          const position = track.scrollLeft;
          const target = direction > 0
            ? Math.min(travel, starts.find((left) => left > position + 2) ?? travel)
            : starts.findLast((left) => left < position - 2) ?? 0;

          if (desktop.matches) {
            window.scrollTo({ top: window.scrollY + section.getBoundingClientRect().top + target, behavior: "smooth" });
          } else {
            track.scrollTo({ left: target });
          }
        };

        previous.addEventListener("click", () => move(-1));
        next.addEventListener("click", () => move(1));
        window.addEventListener("scroll", syncScroll, { passive: true });
        track.addEventListener("scroll", updateButtons, { passive: true });
        desktop.addEventListener("change", measure);
        new ResizeObserver(measure).observe(track);
        measure();
      }
    </script>
  </body>
</html>
